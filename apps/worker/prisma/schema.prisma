generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id         String   @id
  name       String
  apiKeyHash String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  Trace      Trace[]
}

model Span {
  id           String     @id
  traceId      String
  parentSpanId String?
  name         String
  type         SpanType
  status       SpanStatus
  startedAt    DateTime
  endedAt      DateTime?
  input        Json?
  output       Json?
  error        Json?
  model        String?
  provider     String?
  inputTokens  Int?
  outputTokens Int?
  cost         Decimal?   @db.Decimal(12, 8)
  createdAt    DateTime   @default(now())
  Span         Span?      @relation("SpanToSpan", fields: [parentSpanId], references: [id])
  other_Span   Span[]     @relation("SpanToSpan")
  Trace        Trace      @relation(fields: [traceId], references: [id], onDelete: Cascade)

  @@index([parentSpanId])
  @@index([traceId])
  @@index([traceId, startedAt])
}

model Trace {
  id         String       @id
  projectId  String
  name       String
  startedAt  DateTime
  endedAt    DateTime?
  status     TraceStatus
  createdAt  DateTime     @default(now())
  Evaluation Evaluation[]
  Span       Span[]
  Project    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, startedAt])
}

model Evaluation {
  id        String        @id @default(uuid())
  traceId   String
  spanId    String?
  name      String
  score     Float
  reason    String
  provider  String
  model     String
  createdAt DateTime @default(now())
  Trace     Trace    @relation(fields: [traceId], references: [id])
}

enum SpanStatus {
  RUNNING
  SUCCESS
  ERROR
}

enum SpanType {
  AGENT
  LLM
  TOOL
  RETRIEVAL
  CUSTOM
}

enum TraceStatus {
  RUNNING
  SUCCESS
  ERROR
}
