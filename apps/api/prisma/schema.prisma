generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id         String @id @default(uuid())
  name       String
  apiKeyHash String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  traces Trace[]
}

model Trace {
  id        String @id @default(uuid())
  projectId String
  name      String

  startedAt DateTime
  endedAt   DateTime?
  status    TraceStatus

  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  spans Span[]

  @@index([projectId])
  @@index([projectId, startedAt])
}

model Span {
  id      String @id @default(uuid())
  traceId String

  parentSpanId String?

  name   String
  type   SpanType
  status SpanStatus

  startedAt DateTime
  endedAt   DateTime?

  input  Json?
  output Json?
  error  Json?

  model    String?
  provider String?

  inputTokens  Int?
  outputTokens Int?

  cost Decimal? @db.Decimal(12, 8)

  createdAt DateTime @default(now())

  trace Trace @relation(fields: [traceId], references: [id], onDelete: Cascade)

  parentSpan Span? @relation("SpanHierarchy", fields: [parentSpanId], references: [id], onDelete: SetNull)

  childSpans Span[] @relation("SpanHierarchy")

  @@index([traceId])
  @@index([traceId, startedAt])
  @@index([parentSpanId])
}

enum TraceStatus {
  RUNNING
  SUCCESS
  ERROR
}

enum SpanStatus {
  RUNNING
  SUCCESS
  ERROR
}

enum SpanType {
  AGENT
  LLM
  TOOL
  RETRIEVAL
  CUSTOM
}
